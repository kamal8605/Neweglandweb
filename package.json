{
  "name": "fastweb",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "chrome >= 80",
    "edge >= 80",
    "firefox >= 78",
    "safari >= 13",
    "ios_saf >= 13"
  ],
  "scripts": {
    "build:pdf-worker": "node scripts/build-pdf-worker.mjs",
    "postinstall": "node scripts/build-pdf-worker.mjs",
    "prebuild": "node scripts/build-pdf-worker.mjs",
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-query": "^5.100.9",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.14.0",
    "next": "^16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-pageflip": "^2.0.3",
    "react-pdf": "^10.5.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
